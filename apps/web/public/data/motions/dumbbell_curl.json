{
  "id": "dumbbell_curl",
  "name": "Standing Dumbbell Biceps Curl",
  "name_zh": "站姿啞鈴二頭彎舉",
  "description": "雙手各持啞鈴，上臂貼近軀幹，屈肘將啞鈴舉起（向心），頂點停留，再緩慢放下（離心）。",
  "duration": 4.6,
  "loop": true,
  "activationConfidence": "approximate",
  "props": [
    { "type": "dumbbell", "bone": "hand_l", "massKg": 8 },
    { "type": "dumbbell", "bone": "hand_r", "massKg": 8 }
  ],
  "phases": [
    { "t0": 0.0, "t1": 0.4, "label": "預備：握緊啞鈴" },
    { "t0": 0.4, "t1": 1.8, "label": "向心收縮：屈肘舉起" },
    { "t0": 1.8, "t1": 2.3, "label": "頂點停留" },
    { "t0": 2.3, "t1": 4.3, "label": "離心收縮：緩慢放下" },
    { "t0": 4.3, "t1": 4.6, "label": "底部" }
  ],
  "roles": {
    "biceps_brachii": "agonist",
    "brachialis": "agonist",
    "brachioradialis": "synergist",
    "pronator_teres": "synergist",
    "triceps_brachii": "antagonist",
    "anconeus": "antagonist",
    "forearm_flexors": "stabilizer",
    "forearm_extensors": "stabilizer",
    "supinator": "synergist"
  },
  "keyframes": [
    { "t": 0.0, "label": "起始", "joints": { "shoulder": [0, 4, 0], "elbow": [5], "wrist": [0, 0] },
      "activation": { "biceps_brachii": 0.08, "brachialis": 0.08, "brachioradialis": 0.05, "pronator_teres": 0.03, "triceps_brachii": 0.05, "anconeus": 0.05, "forearm_flexors": 0.35, "forearm_extensors": 0.2, "supinator": 0.05 } },
    { "t": 0.4, "label": "握緊", "joints": { "shoulder": [0, 4, 0], "elbow": [5], "wrist": [0, 0] },
      "activation": { "biceps_brachii": 0.2, "brachialis": 0.25, "brachioradialis": 0.1, "pronator_teres": 0.05, "triceps_brachii": 0.06, "anconeus": 0.06, "forearm_flexors": 0.5, "forearm_extensors": 0.3, "supinator": 0.1 } },
    { "t": 1.1, "label": "中段（力臂最大）", "joints": { "shoulder": [3, 4, 0], "elbow": [80], "wrist": [5, 0] },
      "activation": { "biceps_brachii": 0.8, "brachialis": 0.85, "brachioradialis": 0.55, "pronator_teres": 0.15, "triceps_brachii": 0.08, "anconeus": 0.08, "forearm_flexors": 0.6, "forearm_extensors": 0.35, "supinator": 0.3 } },
    { "t": 1.8, "label": "頂點", "joints": { "shoulder": [12, 4, 0], "elbow": [135], "wrist": [10, 0] },
      "activation": { "biceps_brachii": 0.6, "brachialis": 0.6, "brachioradialis": 0.35, "pronator_teres": 0.1, "triceps_brachii": 0.1, "anconeus": 0.08, "forearm_flexors": 0.55, "forearm_extensors": 0.3, "supinator": 0.25 } },
    { "t": 2.3, "label": "停留", "joints": { "shoulder": [12, 4, 0], "elbow": [135], "wrist": [10, 0] },
      "activation": { "biceps_brachii": 0.55, "brachialis": 0.55, "brachioradialis": 0.3, "pronator_teres": 0.1, "triceps_brachii": 0.1, "anconeus": 0.08, "forearm_flexors": 0.55, "forearm_extensors": 0.3, "supinator": 0.25 } },
    { "t": 3.3, "label": "離心中段", "joints": { "shoulder": [4, 4, 0], "elbow": [75], "wrist": [5, 0] },
      "activation": { "biceps_brachii": 0.55, "brachialis": 0.6, "brachioradialis": 0.4, "pronator_teres": 0.12, "triceps_brachii": 0.06, "anconeus": 0.06, "forearm_flexors": 0.55, "forearm_extensors": 0.3, "supinator": 0.2 } },
    { "t": 4.3, "label": "底部", "joints": { "shoulder": [0, 4, 0], "elbow": [5], "wrist": [0, 0] },
      "activation": { "biceps_brachii": 0.15, "brachialis": 0.18, "brachioradialis": 0.08, "pronator_teres": 0.04, "triceps_brachii": 0.08, "anconeus": 0.06, "forearm_flexors": 0.45, "forearm_extensors": 0.25, "supinator": 0.05 } },
    { "t": 4.6, "label": "回到起始", "joints": { "shoulder": [0, 4, 0], "elbow": [5], "wrist": [0, 0] },
      "activation": { "biceps_brachii": 0.08, "brachialis": 0.08, "brachioradialis": 0.05, "pronator_teres": 0.03, "triceps_brachii": 0.05, "anconeus": 0.05, "forearm_flexors": 0.35, "forearm_extensors": 0.2, "supinator": 0.05 } }
  ],
  "$comment": "joints / activation 的鍵不含側別，播放器會套用到 bilateral（左右）兩側：shoulder → shoulder_left/right，biceps_brachii → biceps_brachii_left/right。啟動值為依教學文獻描述的定性近似，非 EMG 量測。"
}
