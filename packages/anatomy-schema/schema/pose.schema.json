{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dha.local/schema/pose.schema.json",
  "title": "PoseDefinition",
  "type": "object",
  "required": ["id", "name", "bones"],
  "$defs": {
    "vec3": { "type": "array", "items": { "type": "number" }, "minItems": 3, "maxItems": 3 },
    "quat": { "type": "array", "items": { "type": "number" }, "minItems": 4, "maxItems": 4 },
    "boneTransform": {
      "type": "object",
      "required": ["rotation"],
      "properties": {
        "rotation": { "$ref": "#/$defs/quat" },
        "position": { "$ref": "#/$defs/vec3" },
        "scale": { "$ref": "#/$defs/vec3" }
      }
    }
  },
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
    "name": { "type": "string" },
    "bones": { "type": "object", "additionalProperties": { "$ref": "#/$defs/boneTransform" } },
    "activation": { "type": "object", "additionalProperties": { "type": "number", "minimum": 0, "maximum": 1 } }
  }
}
