{
  "name": "dynamic-human-anatomy",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.20.0",
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @dha/web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "model:arm": "node tools/blender/run-blender.mjs tools/blender/build_arm_sample.py",
    "validate:glb": "node tools/validators/validate-glb.mjs apps/web/public/models/arm_sample.glb"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "vitest": "^2.1.8",
    "@gltf-transform/core": "^4.1.1"
  }
}
